    "/api/users": {
      "post": {
        "tags": [
          "Users"
        ],
        "description": "Cadastro de novos usuários produtores ou agrônomos.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Dados do usuário",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "João Batista"
                },
                "email": {
                  "type": "string",
                  "example": "joao@email.com"
                },
                "password": {
                  "type": "string",
                  "example": "123456"
                },
                "role": {
                  "type": "string",
                  "example": "produtor"
                },
                "age": {
                  "type": "number",
                  "example": 52
                },
                "gender": {
                  "type": "string",
                  "example": "Masculino"
                },
                "education_level": {
                  "type": "string",
                  "example": "Ensino Fundamental"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Usuário criado com sucesso",
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "example": "uuid"
                },
                "name": {
                  "type": "string",
                  "example": "João Batista"
                },
                "email": {
                  "type": "string",
                  "example": "joao@email.com"
                },
                "role": {
                  "type": "string",
                  "example": "produtor"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "400": {
            "description": "Erro de validação"
          },
          "403": {
            "description": "Criação de administrador não permitida"
          }
        }
      },
      "get": {
        "tags": [
          "Users"
        ],
        "description": "Lista todos os usuários cadastrados. Apenas administradores podem acessar.",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de usuários retornada com sucesso"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Acesso restrito a administradores"
          },
          "500": {
            "description": "Internal Server Error"
          }
